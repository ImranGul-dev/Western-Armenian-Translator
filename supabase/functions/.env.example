# OpenAI
OPENAI_API_KEY=replace_with_a_new_private_key
OPENAI_MODEL=gpt-5.4
OPENAI_TIMEOUT_MS=30000
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0

# Application security
ALLOWED_ORIGINS=http://localhost:3000,https://YOUR_NETLIFY_SITE.netlify.app,https://YOUR_DOMAIN.com
RATE_LIMIT_SALT=replace_with_a_long_random_secret
SITE_URL=http://localhost:3000

# WooCommerce subscriptions. WooCommerce on tunapp.com is the payment source of truth.
# Use the exact same long random secret in WooCommerce > Settings > Advanced > Webhooks.
WOOCOMMERCE_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Legacy Stripe Billing. Keep disabled while WooCommerce billing is active.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_TAX_ENABLED=false

# Legacy optional Stripe Price IDs. WooCommerce product mapping is now stored in the database.
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=

# The widget uses the same OpenAI, RATE_LIMIT_SALT, SITE_URL and Supabase-managed secrets.
# No separate private widget secret is required.
