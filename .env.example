# Browser-safe values only. Copy to .env.local for local development.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BILLING_ENABLED=false

# Never place OpenAI, Stripe, webhook, database, or Supabase service-role secrets here.
# Private values belong in Supabase Edge Function Secrets.
